# ─────────────────────────────────────────────────────────────────────────────
# Database (Neon Postgres)
# In the Neon dashboard → "Connect", copy BOTH connection strings:
#   DATABASE_URL = the POOLED string (host contains "-pooler")  — used at runtime
#   DIRECT_URL   = the DIRECT string (no "-pooler")             — used for migrate/seed
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth — generate a secret with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Cloudflare R2 — QR image storage via an r2-upload Worker (server-side only).
# The Worker accepts { password } -> token, then PUT /api/upload/<key>. The public
# URL is reconstructed as `${R2_PUBLIC_BASE}/${R2_KEY_PREFIX}qr/<slug>.png`.
# ─────────────────────────────────────────────────────────────────────────────
R2_UPLOAD_ENDPOINT="https://upload.example.com"
R2_UPLOAD_PASSWORD="worker-upload-password"
R2_PUBLIC_BASE="https://dl.example.com"
R2_KEY_PREFIX="treasure-hunt/"

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="GDG Prayagraj Treasure Hunt"

# ─────────────────────────────────────────────────────────────────────────────
# Super Admin account created by the seed. Admins do NOT sign up — they are seeded,
# then log in at /login. Used by both `npm run db:seed` and `npm run db:seed:admin`.
# ─────────────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="a-strong-admin-password"
